# Aurora Cafe - Environment Configuration Template
# Copy this file to .env and provide your credentials as needed.

# ==============================================================================
# Database Configuration (Optional for Vercel; Required for persistent MySQL)
# ==============================================================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=aurora_cafe
DB_PORT=3306

# ==============================================================================
# Server Port (Local Backend)
# ==============================================================================
PORT=3000

# ==============================================================================
# AI Integration (Optional: Aura operates out-of-the-box with local persona)
# ==============================================================================
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
